# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log
master_install.log
tests/logs/
/var/log/portalgun/

# Local build artefacts
*.tgz
*.tar.gz

# IDE / editor
.idea/
.vscode/
*.swp
*~

# Temp test files
/tmp/portalgun-*
/tmp/static-readmes/
/tmp/static_tools.json
/tmp/static-tools-map.json
/tmp/bapps*
/tmp/sliver-armory*

# Large pre-built asset bundles (regen via lib/preload_sliver_armory.py)
# Keep the catalog index for offline UX but exclude the 124MB armory tarballs.
data/sliver-armory/
# Pre-bundled Burp BApp assets/clones (regen via lib/preload_bapps.py)
data/bapp-jars/

# But DO keep the small catalog index + BApp catalog (offline-required)
!data/bapp-catalog.json

# Burp Pro license is operator-specific and must NEVER be committed.
# Each operator imports their own via the Admin UI or: portalgun import burp-license <path>
prefs.xml
**/license-import/
**/burp-config/
**/.java/
**/.BurpSuite/
*.userPrefs
# Bundled armory-server binary (re-fetch from sliverarmory/private-armory release)
data/sliver-armory-bin/

# Burp Pro JAR is operator-provided (~660MB, version-specific) — never commit it.
BurpSuitePro.jar
**/burpsuite/BurpSuitePro.jar
**/burpsuite/bapps/
